# ---- Core ----
# Neon: pooled URL (host contains -pooler). `neon env pull` fills this in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mk_ai_travel?schema=public"
# Neon direct (non-pooled) URL, used by Prisma migrate. Optional for local Postgres.
DATABASE_URL_UNPOOLED=""
APP_URL="http://localhost:3000"

# ---- Auth (Auth.js) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required when running outside Vercel (next start, Docker, any host). Without it every
# login returns 500 "UntrustedHost". Enable only behind a proxy that sets Host correctly.
AUTH_TRUST_HOST="true"

# ---- Secret encryption (AES-256-GCM for supplier credentials) ----
# 32 bytes, base64 or 64 hex chars. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---- AI providers (server-side only) ----
AI_PROVIDER="anthropic"            # anthropic | openai | freellmapi
AI_FALLBACK_PROVIDER=""            # optional: anthropic | openai
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
# FreeLLMAPI (an OpenAI-compatible gateway). AI_PROVIDER=freellmapi uses it as the primary provider.
# localhost only works when this app and FreeLLMAPI run on the same computer; the live site needs a public https address.
FREELLMAPI_BASE_URL="http://localhost:3001/v1"
FREELLMAPI_API_KEY=""
FREELLMAPI_MODEL="auto"

# ---- Viator (Partner API v2) - integrated ----
VIATOR_API_ENV="sandbox"           # sandbox | production
VIATOR_SANDBOX_KEY=""
VIATOR_PRODUCTION_KEY=""

# ---- Redis (optional until caching/rate limiting is enabled) ----
REDIS_URL="redis://localhost:6379"

# ---- Not yet implemented (placeholders; need official API docs/credentials) ----
YATRA_API_BASE_URL=""
YATRA_API_KEY=""
KLOOK_API_BASE_URL=""
KLOOK_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Traveldesk B2B API (UAE tours; official OpenAPI at <base>/swagger) ----
TRAVELDESK_API_KEY=""
TRAVELDESK_API_BASE_URL="https://testapi.traveldesk.me"
# Anything other than "production" is treated as test data (labelled SANDBOX, never live inventory).
TRAVELDESK_API_ENV="sandbox"
# Safety switch: with a production Traveldesk key, bookings are refused unless this is "true".
# Confirming charges your agency balance and this app does not collect customer payment yet.
TRAVELDESK_ALLOW_LIVE_BOOKING="false"

# ---- Mapbox (map tiles, place search, driving routes) ----
# Use a PUBLIC token (pk.). It is sent to signed-in browsers for map tiles, so restrict it to your
# site URLs in the Mapbox dashboard. A secret (sk.) token is never sent to the browser, but then the
# map falls back to OpenStreetMap tiles and Mapbox search/routing are switched off (Mapbox requires
# its results to be shown on a Mapbox map).
MAPBOX_API_KEY=""

# ---- Plans and trials ----
# Plan (by key) and length for a new agency's free trial. Plans themselves are edited in /admin/plans.
TRIAL_PLAN_KEY="starter"
TRIAL_DAYS="14"
# Platform admins must have two-factor enabled. Setting this to "true" waives that: never in production.
SUPERADMIN_ALLOW_NO_MFA="false"
